<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r7021e_rrt_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files, parameter files, RViz configuration and Gazebo mazes for Lab 3.
    Holds no nodes: it starts the ones in r7021e_rrt and in the course's own
    r7021e_exploration package, and decides which of them run together.
  </description>
  <maintainer email="domadd-2@student.ltu.se">Dominic Addo</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>r7021e_rrt</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <!-- rviz2 only runs when rviz:=true, so it is an exec_depend rather than a depend.
       turtlebot3_gazebo is deliberately not declared: it lives in a separate workspace
       and is only needed for sim:=true. r7021e_exploration is not declared either, since
       it is installed from the Canvas zip and is in no rosdep index; declaring it would
       stop this workspace building on a machine that has not unpacked it yet. -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
