<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>r7021e_mpc</name>
  <version>0.1.0</version>
  <description>
    Lab 2 Model Predictive Control for the TurtleBot3 Burger: setpoint tracking with
    input and boundary constraints, static obstacle avoidance, and circular trajectory
    tracking with an obstacle.
  </description>
  <maintainer email="domadd-2@student.ltu.se">Dominic Addo</maintainer>
  <license>MIT</license>

  <!-- Every message type the package imports is declared here. -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>

  <!-- do-mpc and casadi are pip packages, not rosdep keys, so they are not declared
       here. See the guide: casadi must be pinned to 3.7.2. -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
