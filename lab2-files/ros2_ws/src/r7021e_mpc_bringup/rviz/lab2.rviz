Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Name: root
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 0.5
    Plane Cell Count: 20
    Color: 160; 160; 164
    Reference Frame: <Fixed Frame>
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Show Names: true
    Show Axes: true
    Show Arrows: false
    Marker Scale: 0.3
  - Class: rviz_default_plugins/Odometry
    Name: Robot path
    Enabled: true
    Topic:
      Value: /odom
      Depth: 5000
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Keep: 5000
    Position Tolerance: 0.02
    Angle Tolerance: 0.05
    Shape:
      Value: Arrow
      Alpha: 1
      Color: 255; 170; 0
      Shaft Length: 0.1
      Shaft Radius: 0.015
      Head Length: 0.05
      Head Radius: 0.03
    Covariance:
      Value: false
  - Class: rviz_default_plugins/LaserScan
    Name: Laser scan
    Enabled: true
    Topic:
      Value: /scan
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 3
    Decay Time: 30
    Color Transformer: FlatColor
    Color: 0; 170; 255
    Alpha: 1
  - Class: rviz_default_plugins/PointStamped
    Name: Closest wall point
    Enabled: true
    Topic:
      Value: /closest_wall_point
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
    Color: 255; 0; 0
    Alpha: 1
    Radius: 0.06
    History Length: 1
  - Class: rviz_default_plugins/Marker
    Name: Goal marker
    Enabled: true
    Topic:
      Value: /goal_marker
      Depth: 5
      Durability Policy: Volatile
      Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: MPC obstacles
    Namespaces: {}
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
      Value: /mpc_obstacles
    Value: true
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: MPC prediction
    Alpha: 1.0
    Buffer Length: 1
    Color: 25; 255; 100
    Line Style: Lines
    Line Width: 0.03
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.0
    Pose Style: None
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
      Value: /mpc_prediction
    Value: true
  - Class: rviz_default_plugins/Path
    Enabled: true
    Name: Reference path
    Alpha: 1.0
    Buffer Length: 1
    Color: 100; 150; 255
    Line Style: Lines
    Line Width: 0.03
    Offset:
      X: 0.0
      Y: 0.0
      Z: 0.0
    Pose Style: None
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Topic:
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
      Value: /reference_path
    Value: true
  Global Options:
    Fixed Frame: odom
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 8
      Pitch: 1.2
      Yaw: 4.7
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>
    Saved: null
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
  Views:
    collapsed: false
